# R / RStudio
.Rhistory
.RData
.Ruserdata
*.Rproj.user
.RDataTmp

# Dependency management
renv/library/
renv/staging/
.packrat/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Keep R folder structure, but do not track script outputs or temp files
R/*
!R/.gitkeep
!R/README.md
!R/*.R

# Raw data (keep private)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/tedcan/

# Raw TED CAN files: keep the folder, ignore the annual CSVs
data/raw/tedcan/*
!data/raw/tedcan/.gitkeep
!data/raw/tedcan/README.md

# Intermediate processed data (keep private)
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

# Documentation and thesis drafts (keep private)
docs/*
!docs/.gitkeep
!docs/README.md

# Logs (publish)
logs/*
!logs/.gitkeep
!logs/README.md
!logs/*.csv

# Output root: keep the folder structure
output/*
!output/.gitkeep
!output/README.md
!output/figures/
!output/tables/

# Figures
output/figures/*
!output/figures/.gitkeep
!output/figures/README.md
!output/figures/*.png

# Tables
output/tables/*
!output/tables/.gitkeep
!output/tables/README.md
!output/tables/*.csv

# Archives / temp files
*.zip
*.7z
*.gz
*.tar
*.rar
*.tmp
